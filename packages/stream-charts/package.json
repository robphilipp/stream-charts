{
  "name": "stream-charts",
  "version": "2.0.0-snapshot",
  "description": "Charts for steaming data",
  "author": "Rob Philipp",
  "homepage": "https://robphilipp.github.io/stream-charts/",
  "license": "MIT",
  "repository": "github:robphilipp/stream-charts",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src/index.ts",
    "src/app/charts",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "README.md",
    "changes.md"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "test": "jest src/app/charts",
    "lint": "eslint src",
    "prepack": "node -e \"for (const f of ['README.md','changes.md']) require('fs').copyFileSync('../../'+f, f)\" && npm run build",
    "prepublishOnly": "npm test",
    "gen-docs": "typedoc",
    "postpack": "node -e \"for (const f of ['README.md','changes.md']) require('fs').rmSync(f,{force:true})\""
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rxjs": "^7.8.0",
    "d3": "^7.9.0"
  },
  "dependencies": {
    "@types/d3": "^7.4.3",
    "fast-shift-array": "^0.1.6",
    "result-fn": "^0.5.3",
    "safe-regex": "^2.1.1"
  },
  "devDependencies": {
    "@babel/core": "^7.26.9",
    "@babel/preset-env": "^7.26.9",
    "@babel/preset-typescript": "^7.27.1",
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.0.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/safe-regex": "^1.1.6",
    "@vitejs/plugin-react": "^6.0.1",
    "d3": "^7.9.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.6.0",
    "jest": "^30.0.5",
    "jest-util": "^30.5.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rxjs": "^7.8.2",
    "ts-jest": "^29.4.15",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1"
  },
  "typedocOptions": {
    "externalSymbolLinkMappings": {
      "result-fn": {
        "Optional": "https://github.com/robphilipp/result-fn/blob/master/docs/Optional.md",
        "Result": "https://github.com/robphilipp/result-fn/blob/master/docs/Result.md"
      },
      "typescript": {
        "Set": "https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/Set",
        "Map": "https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/Map"
      },
      "fast-shift-array": {
        "FastShiftArray": "https://www.npmjs.com/package/fast-shift-array"
      }
    },
    "entryPoints": [
      "src/index.ts"
    ],
    "tsconfig": "tsconfig.build.json",
    "out": "../../docs"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
